[Desktop Entry]
Type=Application
Version=1.0
Name=J.A.R.V.I.S.
GenericName=AI Assistant
GenericName[ru]=ИИ-ассистент
Comment=Voice, quick commands and learning memory
Comment[ru]=Голос, быстрые команды и обучаемая память
Exec=/usr/bin/jarvis
Icon=org.jarvis.Jarvis
Terminal=false
Categories=Utility;Qt;KDE;
StartupNotify=true
StartupWMClass=jarvis
Actions=Overlay;Quick;Settings;
# Screen awareness: KWin lets the installed Jarvis take a screenshot of the window
# the user works in (only when the user turned it on; Jarvis shows when it does).
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2

[Desktop Action Overlay]
Name=Overlay (ask Jarvis from any app)
Name[ru]=Оверлей (спросить Jarvis из любого приложения)
Exec=/usr/bin/jarvis --overlay
Icon=org.jarvis.Jarvis

[Desktop Action Quick]
Name=Quick commands
Name[ru]=Быстрые команды
Exec=/usr/bin/jarvis --quick
Icon=system-search
X-KDE-Shortcuts=Meta+J

[Desktop Action Settings]
Name=Settings
Name[ru]=Настройки
Exec=/usr/bin/jarvis --open settings
Icon=configure
